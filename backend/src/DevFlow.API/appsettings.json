{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },

  "JwtSettings": {
    "Secret": "",
    "Issuer": "DevFlow",
    "Audience": "DevFlow",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },

  "Database": {
    "ApplyMigrations": false
  },

  "Seed": {
    "DemoData": false
  },

  "HttpsRedirection": {
    "Enabled": true
  },

  "ForwardedHeaders": {
    "Enabled": false
  },

  "RateLimiting": {
    "PermitLimitPerMinute": 100,
    "AuthPermitLimitPerMinute": 10
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "devflow-attachments"
  },

  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@devflow.local",
    "FromName": "DevFlow",
    "UseSsl": true
  },

  "GitHub": {
    "Token": ""
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "DevFlow.API"
    }
  },

  "AllowedHosts": "*"
}
