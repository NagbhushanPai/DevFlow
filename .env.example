# Copy to .env and replace every value. .env is git-ignored.

# SQL Server "sa" password: at least 8 chars with upper, lower, digit and symbol.
DEVFLOW_SQL_PASSWORD=replace-with-a-Strong-Passw0rd!

# Redis password.
DEVFLOW_REDIS_PASSWORD=replace-with-a-redis-password

# JWT signing key: at least 32 random characters (the API refuses to start otherwise).
# e.g. PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#      bash:       openssl rand -base64 48
DEVFLOW_JWT_SECRET=replace-with-at-least-32-random-characters

# Seed demo users/projects on first start (true for local demos, false for real deployments).
DEVFLOW_SEED_DEMO_DATA=true
